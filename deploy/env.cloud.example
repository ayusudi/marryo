# Copy values into Secret Manager (never commit real secrets).
# See deploy/gcp.md for gcloud secrets create commands.

PROJECT_ID=your-gcp-project
REGION=asia-southeast1
BUCKET=your-gcp-project-marryo
CLOUD_SQL_CONNECTION=your-gcp-project:asia-southeast1:marryo-pg

# Cloud SQL (Prisma needs hostname localhost; socket path is in ?host=)
# postgresql://marryo:PASSWORD@localhost/marryo?host=/cloudsql/PROJECT:REGION:INSTANCE
DATABASE_URL=

# Auth.js — production FE host (not the *.run.app URL once DNS is live)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_URL=https://marryo.ayusudi.com

# Optional hostnames (mapped via ./deploy/gcp-domains.sh)
# FE_DOMAIN=marryo.ayusudi.com
# SERVER_DOMAIN=server-marryo.ayusudi.com  # same Cloud Run web service
# AI_DOMAIN=ai-marryo.ayusudi.com          # ADK agent

# ClickHouse Cloud
CLICKHOUSE_HOST=xxxxx.clickhouse.cloud
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=marryo
CLICKHOUSE_USER=default
CLICKHOUSE_PASSWORD=

# Vertex (ADC via Cloud Run SA — no key file)
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=asia-southeast1
GOOGLE_GENAI_USE_VERTEXAI=1
GOOGLE_CLOUD_STORAGE_BUCKET=
STORAGE_BACKEND=gcs
PIPELINE_USE_GEMINI=1
MOCK_GEMINI=0
E2E_AUTH=0
