# Marryo - copy to .env and fill in. Never commit .env.
# Nothing here is NEXT_PUBLIC_: every value is read server-side only.

# --- Gemini / Google AI ---
# Used when GOOGLE_GENAI_USE_VERTEXAI=0 (Google AI Studio key).
GEMINI_API_KEY=

# 1 = call Gemini through Vertex AI with your gcloud credentials (default)
# 0 = call Gemini through the AI Studio API using GEMINI_API_KEY
GOOGLE_GENAI_USE_VERTEXAI=1

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=
# Only needed for a service-account key file. Leave empty when using
# `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=

# --- ClickHouse ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=marryo
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# --- Agent ---
# Set once the agent is deployed to Vertex AI Agent Engine (later phase).
AGENT_ENGINE_ENDPOINT=
# Local ADK dev server the Next.js API layer talks to for now.
AGENT_SERVICE_URL=http://127.0.0.1:8000

# --- Upload limits ---
MAX_CLIP_SIZE_MB=500
MAX_CLIPS_PER_PROJECT=30
