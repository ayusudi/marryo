# Marryo - copy to .env and fill in. Never commit .env.
# Nothing here is NEXT_PUBLIC_: every value is read server-side only.

# --- Gemini / Google AI ---
# Used when GOOGLE_GENAI_USE_VERTEXAI=0 (Google AI Studio key).
GEMINI_API_KEY=

# 1 = call Gemini through Vertex AI with your gcloud credentials (default)
# 0 = call Gemini through the AI Studio API using GEMINI_API_KEY
GOOGLE_GENAI_USE_VERTEXAI=1

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=
# Service-account key file path (resolved from repo root, not web/).
# Leave empty to use ADC (`gcloud auth application-default login`).
GOOGLE_APPLICATION_CREDENTIALS=

# Storage backend: `gcs` (default) requires project + bucket above.
# Use `local` for offline demos (writes under UPLOADS_DIR; URIs are local:…).
STORAGE_BACKEND=gcs

# --- ClickHouse ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=marryo
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=
# Used by mcp/toolbox/tools.yaml (env-substituted at Toolbox startup).
CLICKHOUSE_PROTOCOL=https
CLICKHOUSE_SECURE=true

# --- MCP Database Toolbox (Phase 3) ---
# Run: toolbox --config mcp/toolbox/tools.yaml --enable-api --port 5000
# See mcp/toolbox/README.md
MCP_TOOLBOX_URL=http://127.0.0.1:5001

# --- Agent ---
# Set once the agent is deployed to Vertex AI Agent Engine (later phase).
AGENT_ENGINE_ENDPOINT=
# Local ADK dev server the Next.js API layer talks to for now.
AGENT_SERVICE_URL=http://127.0.0.1:8000

# --- Upload limits ---
MAX_CLIP_SIZE_MB=500
MAX_CLIPS_PER_PROJECT=6

# --- Local persistence (Postgres — matches Cloud SQL) ---
# Start: docker compose up -d postgres
DATABASE_URL=postgresql://marryo:marryo@127.0.0.1:5432/marryo
# Where local-backend uploads land (STORAGE_BACKEND=local). Gitignored.
UPLOADS_DIR=./uploads
# Python used for visual validation / identity / textcard CLI (agent venv).
PYTHON_BIN=./agent/.venv/bin/python

# --- Render (Phase 6) ---
FFMPEG_BIN=ffmpeg
RENDER_WIDTH=1920
RENDER_HEIGHT=1080
RENDER_FPS=30
RENDER_CRF=23
RENDER_PRESET=ultrafast

# --- Google Sign-In (Auth.js / NextAuth) ---
# OAuth 2.0 Web client: Google Cloud Console → APIs & Services → Credentials.
# Redirect URI: http://localhost:3100/api/auth/callback/google
AUTH_SECRET=
# openssl rand -base64 32
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# AUTH_URL=http://localhost:3100

# --- E2E (Playwright) ---
# Enables Credentials provider id=e2e for automated studio login.
# Never set E2E_AUTH=1 in production.
E2E_AUTH=1
E2E_AUTH_SECRET=marryo-e2e-secret
