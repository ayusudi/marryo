# Marryo agent - copy to agent/.env and fill in. Never commit agent/.env.
# ADK loads this file automatically when the agent starts.

# --- Gemini / Google AI ---
# 1 = call Gemini through Vertex AI with your gcloud credentials (default)
# 0 = call Gemini through the AI Studio API using GEMINI_API_KEY
GOOGLE_GENAI_USE_VERTEXAI=1
GEMINI_API_KEY=

# ADK reads this name for the AI Studio key path; keep it equal to GEMINI_API_KEY.
GOOGLE_API_KEY=

# --- Google Cloud ---
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_CLOUD_STORAGE_BUCKET=
# Only needed for a service-account key file. Leave empty when using
# `gcloud auth application-default login`.
GOOGLE_APPLICATION_CREDENTIALS=

# --- ClickHouse ---
CLICKHOUSE_HOST=
CLICKHOUSE_PORT=8443
CLICKHOUSE_DATABASE=marryo
CLICKHOUSE_USER=
CLICKHOUSE_PASSWORD=

# --- Model ---
# Override the model the Film Director runs on.
MARRYO_MODEL=gemini-2.5-flash
